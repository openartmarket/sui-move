{
	"name": "@coownable/sui",
	"version": "0.4.0",
	"publishConfig": {
		"access": "public"
	},
	"description": "Contracts for Open Art Market (https://www.openartmarket.com/)",
	"author": {
		"name": "Open Art Market",
		"email": "hi@openartmarket.com",
		"url": "https://github.com/openartmarket/sui-move"
	},
	"files": [
		"./dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./helpers": {
			"types": "./dist/helpers.d.ts",
			"import": "./dist/helpers.js"
		}
	},
	"scripts": {
		"test": "vitest run --coverage",
		"compile": "tsc --build --noEmit",
		"build": "tsc --build --clean tsconfig.build.json && tsc --build tsconfig.build.json",
		"prepublishOnly": "pnpm build",
		"release": "np",
		"upgrade": "npm-check-updates --upgrade",
		"check": "biome check --write --unsafe src test"
	},
	"repository": "openartmarket/sui-move",
	"license": "MIT",
	"packageManager": "pnpm@10.30.1",
	"dependencies": {
		"@mysten/bcs": "1.9.2",
		"@mysten/sui": "1.45.2",
		"@shinami/clients": "0.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/node": "25.6.0",
		"@vitest/coverage-v8": "4.1.5",
		"@vitest/ui": "4.1.5",
		"eslint": "10.3.0",
		"np": "^11.2.0",
		"npm-check-updates": "22.1.0",
		"prettier": "3.8.3",
		"tsx": "4.21.0",
		"typescript": "6.0.3",
		"vite": "8.0.10",
		"vitest": "4.1.5"
	},
	"np": {
		"branch": "main"
	}
}
