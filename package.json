{
	"name": "@openartmarket/sui",
	"version": "0.3.0",
	"description": "Contracts for Open Art Market (https://www.openartmarket.com/)",
	"author": {
		"name": "Open Art Market",
		"email": "hi@openartmarket.com",
		"url": "https://github.com/openartmarket/sui-move"
	},
	"files": [
		"./dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"test": "vitest run --coverage",
		"compile": "tsc --build --noEmit",
		"build": "tsup",
		"upgrade": "npm-check-updates --upgrade",
		"check": "npx @biomejs/biome check --write --unsafe src test"
	},
	"repository": "openartmarket/sui-move",
	"license": "MIT",
	"dependencies": {
		"@mysten/bcs": "1.9.2",
    "@mysten/sui": "1.45.2",
		"@shinami/clients": "0.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/node": "25.6.0",
		"@vitest/coverage-v8": "4.1.5",
		"@vitest/ui": "4.1.5",
		"eslint": "10.3.0",
		"npm-check-updates": "22.1.0",
		"prettier": "3.8.3",
		"tsup": "8.5.1",
		"tsx": "4.21.0",
		"typescript": "6.0.3",
		"vite": "8.0.10",
		"vitest": "4.1.5"
	},
	"tsup": {
		"dts": true,
		"entryPoints": [
			"src/index.ts"
		],
		"external": [
			"@mysten/bcs",
			"@mysten/sui",
      "@shinami/clients"
		],
		"format": [
			"esm"
		],
		"sourcemap": true,
		"splitting": false,
		"bundle": true,
		"clean": true
	}
}
