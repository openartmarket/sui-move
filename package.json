{
	"name": "@coownable/sui",
	"version": "1.0.1",
	"publishConfig": {
		"access": "public"
	},
	"description": "Sui Move contract for Coownable — fractional ownership of any asset class",
	"author": {
		"name": "Coownable",
		"email": "hi@openartmarket.com",
		"url": "https://github.com/openartmarket/sui-move"
	},
	"files": [
		"./dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./helpers": {
			"types": "./dist/helpers.d.ts",
			"import": "./dist/helpers.js"
		}
	},
	"scripts": {
		"test": "vitest run --coverage",
		"compile": "tsc --build --noEmit",
		"build": "tsc --build --clean tsconfig.build.json && tsc --build tsconfig.build.json",
		"prepublishOnly": "pnpm build",
		"release": "np",
		"upgrade": "npm-check-updates --upgrade",
		"check": "biome check --write --unsafe src test"
	},
	"repository": "openartmarket/sui-move",
	"license": "MIT",
	"packageManager": "pnpm@11.1.3",
	"dependencies": {
		"@mysten/bcs": "2.0.5",
		"@mysten/sui": "2.17.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/node": "25.9.1",
		"@vitest/coverage-v8": "4.1.7",
		"@vitest/ui": "4.1.7",
		"eslint": "10.4.0",
		"np": "11.2.1",
		"npm-check-updates": "22.2.0",
		"prettier": "3.8.3",
		"tsx": "4.22.3",
		"typescript": "6.0.3",
		"vite": "8.0.13",
		"vitest": "4.1.7"
	},
	"np": {
		"branch": "main"
	}
}
